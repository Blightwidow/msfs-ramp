<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = GUI app, no console window. -->
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 = most reliable target for the official managed SimConnect wrapper -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RAMP</AssemblyName>
    <RootNamespace>MsfsAirportPreloader</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms + registry access. Explicit refs are the reliable way to pull these in for
         net48 under the SDK-style project (UseWindowsForms is not honored on .NET Framework). -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- SimBrief OFP fetch (WebClient) + XML parse (XDocument), both built-in framework assemblies. -->
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The official managed SimConnect wrapper ships with the MSFS 2020 SDK:
        <SDK>\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll
      Copy that DLL next to this .csproj (or fix the HintPath), and the native
      SimConnect.dll (same SDK, \lib\SimConnect.dll) next to the built .exe.
    -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>lib\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Native SimConnect.dll copied NEXT TO the exe (Link flattens the lib\ subpath)
         so the managed wrapper can P/Invoke it. Without Link it lands in bin\...\lib\. -->
    <None Include="lib\SimConnect.dll" Condition="Exists('lib\SimConnect.dll')">
      <Link>SimConnect.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="airports.csv" Condition="Exists('airports.csv')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="preloader.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
